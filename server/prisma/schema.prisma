// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users          User[]
  services       Service[]
  availabilities Availability[]
  bookings       Booking[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  passwordHash   String
  name           String
  role           Role     @default(CUSTOMER)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  availabilities   Availability[]
  staffBookings    Booking[]      @relation("StaffBookings")
  customerBookings Booking[]      @relation("CustomerBookings")

  @@unique([organizationId, email])
  @@index([organizationId, role])
}

model Service {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  durationMinutes Int
  bufferMinutes   Int      @default(0)
  priceInPaise    Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([organizationId])
}

model Availability {
  id             String   @id @default(uuid())
  organizationId String
  staffId        String
  dayOfWeek      Int
  startTime      String
  endTime        String
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        User         @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([organizationId])
}

model Booking {
  id              String        @id @default(uuid())
  organizationId  String
  serviceId       String
  staffId         String
  customerId      String
  startTime       DateTime      @db.Timestamptz(3)
  endTime         DateTime      @db.Timestamptz(3)
  status          BookingStatus @default(HELD)
  holdExpiresAt   DateTime?     @db.Timestamptz(3)
  razorpayOrderId String?       @unique
  notes           String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff         User           @relation("StaffBookings", fields: [staffId], references: [id], onDelete: Restrict)
  customer      User           @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  paymentEvents PaymentEvent[]

  @@unique([organizationId, staffId, startTime])
  @@index([organizationId, status])
  @@index([customerId])
}

model PaymentEvent {
  id                String   @id @default(uuid())
  bookingId         String?
  razorpayEventId   String   @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  eventType         String
  amountInPaise     Int?
  currency          String   @default("INR")
  status            String
  payload           Json
  processedAt       DateTime @default(now()) @db.Timestamptz(3)

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([razorpayOrderId])
}
